# Copy to .env and replace every CHANGE_ME value. Never commit .env.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=n8n

# ── n8n → PostgreSQL connection ────────────────────────────────────────────
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
DB_POSTGRESDB_USER=${POSTGRES_USER}
DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_POOL_SIZE=10
DB_POSTGRESDB_CONNECTION_TIMEOUT=30000
DB_POSTGRESDB_IDLE_CONNECTION_TIMEOUT=60000

# ── Redis (queue mode) ─────────────────────────────────────────────────────
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379

# ── Execution mode ─────────────────────────────────────────────────────────
# "queue" distributes workflow executions to the n8n-worker via Redis
EXECUTIONS_MODE=queue

# ── n8n instance ───────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/

# ── Security ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Set it once before the first run. Losing this key makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=CHANGE_ME

# ── Timezone ───────────────────────────────────────────────────────────────
# Use your own IANA timezone, e.g. America/Chicago.
GENERIC_TIMEZONE=UTC
TZ=UTC

# ── Execution pruning ──────────────────────────────────────────────────────
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000

# ── Diagnostics ────────────────────────────────────────────────────────────
N8N_DIAGNOSTICS_ENABLED=false

# ── Push backend ───────────────────────────────────────────────────────────
N8N_PUSH_BACKEND=websocket
